/*
	Built in functions:
	- XX.convert<YY>()
		~ convert from numeric type XX to numeric type YY, keeping the value the same
		~ returns by value
	- XX.reinterpret<YY>()
		~ reinterpret the bytes of type XX as type YY
		~ type YY must be of size smaller or equal to size of XX
		~ returns by reference
*/

extern printf(...);

type CharArray = [u8];

type Result = enum {
	Ok: struct {
		value: u32;
	};
	Err: struct {
		errorCode: i32;
		message: *CharArray;
	};
};

type Code = enum {
	Success;
	Failure;
	Unknown;
};

type String = struct {
	data: *CharArray;
	length: u64;
};

type Vec3 = struct {
	x: f32;
	y: f32;
	z: f32;
};

fn add(self v: &Vec3, other: &Vec3) -> Vec3 {
	return Vec3 { .x = v.x + other.x, .y = v.y + other.y, .z = v.z + other.z };
}

// T parameter just means that a, b and ret type have the same type
// 'Number' is a built-in interface signifying that type T must be one of the number types available in the language
fn add<T: Number>(a: &T, b: &T) -> T {
	return a + b;
}

// function overloading is essential and works across extensions, generics and normal functions
fn add(a: &Vec3, b: &Vec3) -> Vec3 {
	return a.add(b);
}

fn get_float() -> f32 {
	return 7.421;
}

fn main() -> u32 {
	const a: u32 = 23;
	const b: i8 = 123;

	const c = add(10, 20);	// T implicitly resolved as an integer type (i32 by default)
	const d = add<u64>(10, 20); // T is explicitly a u64, 10 and 20 are treated as such

	// built-in functions also exist
	// in this case reinterpret<T>(self s: &T) is implicitly defined for all types (even user-made ones)
	// "reinterpret" reinterprets the bytes of d as a u16 and returns them by reference
	// however since there is no & operator before the call, the referenced value gets copied into a new u16
	const e = d.reinterpret<u16>();

	// "convert" is similar to "reinterpret" but it converts to the new type and returns by value
	// this one is only defined on Number types and certain array types implicitly (think [u8; 4] -> u32 conversion)
	const g = d.convert<i16>();

	const f = get_float();

	const str: [u8] = [ 1, 2, 3, 4, 5, 6, 7 ];
	const heapStr: *[u8] = new [ 10, 20, 30, 40, 50 ];
	const refStr: &[u8] = &heapStr;

	const arr: [f32; 5] = [ 1, 2, 3, 4, 5 ];
	const arr2 = [32.0; 10];

	const vec = Vec3 { .x = 1.0, .y = 2.0, .z = 3.0 };
	const vecSum = vec.add(Vec3 { .x = 0.0, .y = 10.0, .z = 15.0 });

	const anonStruct = { .x = 10.0, .y = "abc", .z = 32 };

	var ref = &arr[2];
	ref += &arr[3];
	printf("ref value: %f\n", ref);

	ref = arr2[1];
	printf("ref value: %f\n", ref);

	call(
		| &arr | () { return arr[4]; },
		(x: u32) { return; }
	);

	const value = for (arr, arr2) | &var val1, &var val2 | {
		printf("val1: %f, val2: %f\n", val1, val2);
		if (val1 > 3.0)
		{
			break val2;
		}
	} else break 0.0;

	var index = 0;
	while (index < arr.length()) {
		printf("arr[%d]: %f\n", index, arr[index]);
		index += 1;
	}

	// match without payload
	const code = Code::Success;
	match (code) {
		Code::Success printf("success\n");
		Code::Failure printf("failure\n");
		Code::Unknown printf("unknown\n");
		else printf("unhandled\n");
	}

	// match with payload, used as expression
	const result = Result::Ok({ .value = 255 });
	const msg = match (result) {
		Result::Ok |val| break val.value;
		Result::Err |err| break err.errorCode;
		else break 0;
	};

	return 0;
}

fn call(func: () -> u64, func2: (u32)) {
	func();
	func2(123);
}

fn do_something(param1: &var Vec3, param2: f32)
{
	
}

fn do_something2(param1: &var &Vec3)
{
	

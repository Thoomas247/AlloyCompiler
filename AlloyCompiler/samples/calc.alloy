// A complete mini-compiler written in Alloy: it tokenizes an arithmetic
// expression string, parses it (recursive descent with precedence) into a
// recursive AST of owning pointers, and evaluates it. Proof that the language
// can host its own compiler — String/Vec, char handling, recursive enums/
// structs, and `&var self` state mutation all working together.
//
//   "2 + 3 * 4 - 1"  ->  13
import std::vec;

extern printf(...) -> i32;

// ---- Tokens ---------------------------------------------------------------
type Token = enum {
	Num: i64;
	Plus;
	Minus;
	Star;
	LParen;
	RParen;
	End;
};

// ---- AST ------------------------------------------------------------------
type BinOp = struct {
	left: *Expr;
	right: *Expr;
};

type Expr = enum {
	Num: i64;
	Add: BinOp;
	Sub: BinOp;
	Mul: BinOp;
};

fn num(n: i64) -> *Expr { return new Expr::Num(n); }
fn add(l: *Expr, r: *Expr) -> *Expr { return new Expr::Add(BinOp { .left = move l, .right = move r }); }
fn sub(l: *Expr, r: *Expr) -> *Expr { return new Expr::Sub(BinOp { .left = move l, .right = move r }); }
fn mul(l: *Expr, r: *Expr) -> *Expr { return new Expr::Mul(BinOp { .left = move l, .right = move r }); }

fn eval(e: &Expr) -> i64 {
	match (e) {
		Expr::Num |n| { return n; }
		Expr::Add |b| { return eval(b.left) + eval(b.right); }
		Expr::Sub |b| { return eval(b.left) - eval(b.right); }
		Expr::Mul |b| { return eval(b.left) * eval(b.right); }
	}
	return 0;
}

// ---- Lexer ----------------------------------------------------------------
fn isDigit(b: u8) -> bool {
	return b >= 48 && b <= 57;     // '0'..'9'
}

fn tokenize(src: &[u8]) -> Vec<Token> {
	var toks: Vec<Token> = vecNew<Token>(Token::End);
	var i: u64 = 0;
	while (i < src.length()) {
		var b: u8 = src[i];
		if (b == 32) {                       // space
			i += 1;
		} else {
			if (isDigit(b)) {
				var n: i64 = 0;
				while (i < src.length() && isDigit(src[i])) {
					n = n * 10 + (src[i].convert<i64>() - 48);
					i += 1;
				}
				toks.push(Token::Num(n));
			} else {
				if (b == 43) { toks.push(Token::Plus); i += 1; }
				else { if (b == 45) { toks.push(Token::Minus); i += 1; }
				else { if (b == 42) { toks.push(Token::Star); i += 1; }
				else { if (b == 40) { toks.push(Token::LParen); i += 1; }
				else { if (b == 41) { toks.push(Token::RParen); i += 1; }
				else { i += 1; } } } } }
			}
		}
	}
	toks.push(Token::End);
	return toks;
}

// ---- Parser (recursive descent) -------------------------------------------
type Parser = struct {
	toks: Vec<Token>;
	pos: u64;
};

fn peek(self p: &Parser) -> Token {
	return p.toks.get(p.pos);
}

fn advance(self p: &var Parser) {
	p.pos += 1;
}

// factor := NUMBER | '(' expr ')'
fn parseFactor(self p: &var Parser) -> *Expr {
	var t: Token = p.peek();
	match (t) {
		Token::Num |n| { p.advance(); return num(n); }
		Token::LParen {
			p.advance();
			var e: *Expr = p.parseExpr();
			p.advance();                       // consume ')'
			return move e;
		}
	}
	return num(0);
}

// term := factor { '*' factor }
fn parseTerm(self p: &var Parser) -> *Expr {
	var lhs: *Expr = p.parseFactor();
	var going: bool = true;
	while (going) {
		match (p.peek()) {
			Token::Star { p.advance(); lhs = mul(move lhs, p.parseFactor()); }
			else { going = false; }
		}
	}
	return move lhs;
}

// expr := term { ('+' | '-') term }
fn parseExpr(self p: &var Parser) -> *Expr {
	var lhs: *Expr = p.parseTerm();
	var going: bool = true;
	while (going) {
		match (p.peek()) {
			Token::Plus  { p.advance(); lhs = add(move lhs, p.parseTerm()); }
			Token::Minus { p.advance(); lhs = sub(move lhs, p.parseTerm()); }
			else { going = false; }
		}
	}
	return move lhs;
}

fn run(src: &[u8]) -> i64 {
	var p: Parser = Parser { .toks = tokenize(src), .pos = 0 };
	var ast: *Expr = p.parseExpr();
	return eval(ast);
}

fn main() -> u32 {
	printf("2 + 3 * 4 - 1   = %lld\n", run("2 + 3 * 4 - 1"));
	printf("(2 + 3) * 4     = %lld\n", run("(2 + 3) * 4"));
	printf("10 + 20 * 3     = %lld\n", run("10 + 20 * 3"));
	return 0;
}

// Generic enum: Maybe<T> monomorphises per use.
extern printf(...) -> i32;

type Maybe<T> = enum {
	Some: T;
	Nothing;
};

fn main() -> u32 {
	var x: Maybe<u32> = Maybe::Some(42);
	var y: Maybe<u32> = Maybe::Nothing;

	match (x) {
		Maybe::Some |v| { printf("x = Some(%u)\n", v); }
		Maybe::Nothing { printf("x = None\n"); }
	}

	match (y) {
		Maybe::Some |v| { printf("y = Some(%u)\n", v); }
		Maybe::Nothing { printf("y = None\n"); }
	}
	return 0;
}

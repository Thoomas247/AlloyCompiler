// Positive: a generic enum monomorphises per use; Maybe<u32>::Some(x) and
// Maybe<u32>::Nothing both type-check against a `var x: Maybe<u32>` slot.
type Maybe<T> = enum {
	Some: T;
	Nothing;
};

fn main() -> u32 {
	var a: Maybe<u32> = Maybe::Some(7);
	var b: Maybe<u32> = Maybe::Nothing;
	return 0;
}

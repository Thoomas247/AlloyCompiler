/*
	Built in functions:
	- XX:to_YY()
		~ convert from numeric type XX to numeric type YY, keeping the value the same
		~ returns by value
	- XX:as_YY()
		~ reinterpret the bytes of type XX as type YY
		~ type YY must be of size smaller or equal to size of XX
		~ returns by reference
*/

extern printf(...);

type CharArray = [u8];	// aliases cannot hide pointers or references

type Result = enum {
	Ok: struct {
		value: u32;
	};
	Err: struct {
		errorCode: i32;
		message: *CharArray;
	};
};

type Code = enum {
	Success;
	Failure;
	Unknown;
};

type String = struct {
	data: *CharArray;
	length: u64;
};

type Vec3 = struct {
	x: f32;
	y: f32;
	z: f32;
};

fn main() -> int {
	const a: u32 = 23;
	const b: i8 = 123;
	const f = get_float();

	const str: [u8] = [ 1, 2, 3, 4, 5, 6, 7 ];
	const heapStr: *[u8] = new [ 10, 20, 30, 40, 50 ];
	const refStr: &[u8] = &heapStr;

	const arr: [f32; 5] = [ 1, 2, 3, 4, 5 ];
	const arr2 = [32.0:to_f32(); 10];	// implicit type, array of floats with size 10, all initialized with value 32.0

	var ref = &arr[2];
	ref += &arr[3];

	printf("ref value: %f\n", ref);

	ref = arr2[1];

	printf("ref value: %f\n", ref);

	call(
		| &arr | () -> { return arr[4]; },
		(x: u32) -> { return; }
	);

	const value = for (arr, arr2) | &var val1, &var val2 | {
		printf("val1: %f, val2: %f\n", val1, val2);

		if (val1 > 3.0)
		{
			break val2;
		}
	} else break 0.0;

	var index = 0;
	while (index < arr.length()) {
		printf("arr[%d]: %f\n", index, arr[index]);
		index += 1;
	}

	return 0;
}

fn get_float() -> f32 {
	return 7.421;
}

fn call(func: () -> u64, func2: (u32)) {
	func();
	func2(123);
}

fn do_something(param1: &var Vec3, param2: f32)
{
	
}

fn do_something2(param1: &var &Vec3)
{
	
}

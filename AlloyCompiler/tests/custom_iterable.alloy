// Positive: a `for` loop drives the custom iterable protocol —
//   iterator(self &C) -> Iter ;  next(self &var Iter) -> Option<T>.
type RangeIter = struct { current: u32; limit: u32; };
type Range = struct { limit: u32; };

fn iterator(self r: &Range) -> RangeIter {
	return RangeIter { .current = 0, .limit = r.limit };
}

fn next(self it: &var RangeIter) -> Option<u32> {
	if (it.current < it.limit) {
		var v: u32 = it.current;
		it.current = it.current + 1;
		return Option::Some(v);
	}
	return Option::None;
}

fn main() -> u32 {
	const r: Range = Range { .limit = 4 };
	var total: u32 = 0;
	for (r) |v| {
		total = total + v;
	}
	return 0;
}

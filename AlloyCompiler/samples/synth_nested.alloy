// Synth type with a named-type member — `#Inner` reflected into the env.

extern printf(...) -> i32;

type Inner = struct { v: i32; };

macro makeOuter() {
	var t = #struct_type();
	t.add_member("inner", #Inner);
	t.add_member("tag",   #u32);
	return t;
}

type Outer = #makeOuter();

fn main() -> u32 {
	const o = Outer { .inner = Inner { .v = 42 }, .tag = 7 };
	printf("inner.v=%d tag=%u\n", o.inner.v, o.tag);
	return 0;
}

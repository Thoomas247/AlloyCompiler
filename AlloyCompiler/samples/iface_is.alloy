extern printf(...) -> i32;

interface Shape {
	fn area() -> f32;
}

type Circle : Shape = struct { r: f32; };
type Square : Shape = struct { s: f32; };
type Triangle : Shape = struct { base: f32; height: f32; };

fn area(self c: &Circle)   -> f32 { return c.r * c.r; }
fn area(self s: &Square)   -> f32 { return s.s * s.s; }
fn area(self t: &Triangle) -> f32 { return t.base * t.height; }

fn describe(s: &Shape) {
	// `if (s is Type) |c| { ... }` — non-exhaustive downcast with capture.
	if (s is Circle) |c| {
		printf("circle r=%.1f\n", c.r);
	}
	// `match (s) { Type |c| ... }` — exhaustive downcast on concrete types.
	match (s) {
		Circle   |c| { printf("match: circle r=%.1f\n", c.r); }
		Square   |sq| { printf("match: square s=%.1f\n", sq.s); }
		Triangle |t| { printf("match: triangle b=%.1f h=%.1f\n", t.base, t.height); }
		else { printf("match: unknown\n"); }
	}
}

fn main() -> u32 {
	const c  = Circle { .r = 2.0 };
	const sq = Square { .s = 3.0 };
	const t  = Triangle { .base = 4.0, .height = 5.0 };
	describe(&c);
	describe(&sq);
	describe(&t);
	return 0;
}

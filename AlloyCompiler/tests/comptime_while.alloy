// §6.1 — a '#'-marked function call runs at compile time, including loops and
// local mutation inside the called function. Positive test.

fn compute() -> u32 {
	var sum = 0;
	var i = 0;
	while (i < 5) {
		sum += i;
		i += 1;
	}
	return sum;
}

fn run() -> u32 {
	const total = #compute();
	return total;
}

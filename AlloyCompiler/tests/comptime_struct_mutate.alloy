// §6.1 — comptime mutation through field and element assignment.

fn build_struct() -> i32 {
	var p = { .a = 1, .b = 2 };
	p.a = 10;
	p.b += 5;
	return p.a + p.b;          // 10 + 7 = 17
}

fn build_array() -> i32 {
	var arr = [ 10, 20, 30 ];
	arr[1] = 99;
	return arr[0] + arr[1] + arr[2];   // 10 + 99 + 30 = 139
}

fn run() -> i32 {
	const x = #build_struct();
	const y = #build_array();
	return x + y;
}
